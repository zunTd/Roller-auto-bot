{
  "manifest_version": 3,
  "name": "RollerCoin Auto Helper",
  "version": "2.3.35",
  "description": "RollerCoin Helper: auto-play selector and reward collection for RollerCoin.",
  "permissions": ["tabs", "storage", "windows"],
  "host_permissions": ["*://*.rollercoin.com/*", "*://rollercoin.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RollerCoin Auto Helper",
    "default_icon": "icon48.png"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.rollercoin.com/*", "*://rollercoin.com/*"],
      "js": ["content.js", "reward-flow.js", "game-selection.js", "games/hamster-climber.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.rollercoin.com/*", "*://rollercoin.com/*"],
      "js": ["games/coins2048.js", "games/coinclick.js", "games/flappy-rocket.js", "games/coin-flip.js", "games/coin-fisher.js", "games/coin-match.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}
